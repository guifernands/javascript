<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
  <div class="row justify-content-center">
    
    <div class="cartao-moderno col-lg-10 my-5">
      <h1 class="text-center">Agenda</h1>
      
      <% if(contatos.length > 0) { %>
        <p class="text-center lead">Seus contatos estão abaixo</p> 
        
        <%- include('includes/messages') %>

        <div class="table-responsive mt-4">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Nome</th>
                <th>Sobrenome</th>
                <th>Telefone</th>
                <th>E-mail</th>
                <th></th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% contatos.forEach(contato => { %>
              <tr>
                <td><%= contato.nome %></td>
                <td><%= contato.sobrenome %></td>
                <td><%= contato.telefone %></td>
                <td><%= contato.email %></td>
                <td><a href="/contato/index/<%= contato._id %>">Editar</a></td>
                <td><a class="text-danger" href="/contato/delete/<%= contato._id %>">Excluir</a></td>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

      <% } else { %> 
        <p class="text-center lead">Você ainda não tem contatos registrados.</p> 
        <%- include('includes/messages') %>
      <% } %>
    </div>

  </div>
</div>

<%- include('includes/footer') %>